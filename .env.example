PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=car_rental
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

ADMIN_EMAIL=admin@greenrental.ae
# Quote passwords that contain # — otherwise dotenv treats # as a comment
ADMIN_PASSWORD="Admin123!@#"
ADMIN_NAME=Fleet Admin

UPLOAD_DIR=uploads
